# 复制为 .env 后修改：cp .env.example .env

# Web 面板登录页的用户名 / 密码（改密码后已登录的会话全部失效）。监听在 0.0.0.0 时必须设置密码
CC_SWITCH_WEB_USERNAME=admin
CC_SWITCH_WEB_PASSWORD=change-me

# 宿主机上对外暴露的端口
CC_SWITCH_PORT=8765

# 按天统计使用的时区
TZ=Asia/Shanghai

# 后台扫描会话日志的间隔（秒），0 表示只在启动时扫描
CC_SWITCH_SYNC_INTERVAL_SECS=600

# 镜像（默认用 GitHub Actions 构建的镜像；也可以 docker compose build 本地构建）
CC_SWITCH_IMAGE=ghcr.io/berry-shake/cc-switch-docker:latest
